{
  // This authoring copy plans a comparative energy experiment. INA219 output is not automatically metrology-grade.
  "schema_version": "2.0",
  "state": "template",
  "experiment_id": "power-policy",
  "title": "Energy-Aware Policy Check",
  "purpose": {
    "question": "Can a bounded low-power endpoint profile reduce measured energy without violating critical service?",
    "comparison": "Always-on and low-power endpoint profiles under the same measured traffic block.",
    "primary_metric": "Energy per successfully delivered critical packet, reported with service quality."
  },
  "setup": {
    // Identify measured endpoint, INA219 sensor ID, rail boundary, I2C setup, shunt value, and calibration record.
    "nodes": null,
    "thread_channel": null,
    "placement": null,
    "firmware_reference": null
  },
  "execution": {
    // Use steady-state duration selected from pilots; include enough time for the sampled energy signal to be meaningful.
    "warmup_s": null,
    "measurement_s": null,
    "cooldown_s": null,
    "repetitions": null,
    "seed": null
  },
  "traffic": {
    // Copy the matched baseline traffic. Do not obtain lower energy by silently reducing offered work.
    "streams": null
  },
  "scenario": {
    // Usually event none. Target may identify the low-power endpoint/profile being compared.
    "event": null,
    "at_s": null,
    "duration_s": null,
    "target": null
  },
  "treatment": {
    // Use power mode and one documented power-profile action only after fallback/observability are defined.
    "mode": null,
    "candidate_action": null,
    // Name a profile whose calibration ID includes the power measurement boundary and overhead control.
    "control_profile": null,
    "host_model": null,
    "remote_actuation": null
  },
  "acceptance": {
    "counter_reconciliation": null,
    // Use the same critical service floor for always-on and low-power conditions.
    "minimum_critical_on_time_pdr": null,
    // Define an invalid result such as absent calibration, missing energy data, or service-floor failure.
    "negative_case": null
  },
  "evidence": {
    // Require energy samples, calibration record, sampler overhead control, raw counters, and matched condition evidence.
    "required_artifacts": null,
    "operator_notes_required": null,
    "topology_photo_required": null
  },
  "_todo": [
    {
      "path": "/setup",
      "action": "Freeze the electrical measurement boundary.",
      "method": "Record rail, inclusion/exclusion of regulator, LEDs, serial, and sensor, then calibrate or explicitly limit interpretation to relative values.",
      "done_when": "The evidence states exactly what energy is measured."
    },
    {
      "path": "/treatment",
      "action": "Define observable and recoverable profiles.",
      "method": "Specify always-on/low-power behavior, wake/attachment, acknowledgement, fallback, and sampler-enabled versus sampler-disabled overhead control.",
      "done_when": "A disconnected endpoint cannot be mislabeled as energy-efficient."
    },
    {
      "path": "/execution",
      "action": "Freeze matched service and traffic before energy data are observed.",
      "method": "Copy stable traffic, set duration/repetitions from steady pilots, and apply the same service floor to both profiles.",
      "done_when": "Energy is interpreted only alongside matched service evidence."
    }
  ]
}
