    classDef decision fill:#713f12,stroke:#fbbf24,color:#fef3c7;
    class runtime,clock,codec,protocoltest,transport endpoint;
    class provisioning,guard,bridge,rxq,diagnostic,obsq,backhaul gateway;
    class manifest,config,profile,broker,recorder,coordinator host;
    class lifecycle,aggregate,week4 evidence;
    class entry,admission,closure,repair,preserve,profileblocked decision;
